# TimescaleDB (telemetry)
# From Docker use host.docker.internal; on host use localhost
TS_HOST=host.docker.internal
TS_PORT=5433
TS_USER=postgres
TS_PASS=postgres
TS_DB=telemetry
DB_HOST=host.docker.internal
DB_PORT=5433
DB_NAME=telemetry
DB_USER=postgres
DB_PASSWORD=postgres
DB_TABLE=telemetry

# Inference
MODEL_PATH=model_artifacts/model.pkl
POLL_INTERVAL_SECONDS=30
ALERT_THRESHOLD=0.5
WINDOW_MINUTES=5
POLL_LOOKBACK_MINUTES=2

# MQTT (device-specific topics: wifi/alerts/{device_id}/anomaly)
MQTT_ENABLED=true
MQTT_HOST=0.tcp.in.ngrok.io
MQTT_PORT=17241
MQTT_BASE_TOPIC=wifi/alerts
# MQTT_USER=
# MQTT_PASS=
